{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/test",
      "dest": "/api/test.js"
    },
    {
      "src": "/generate-token",
      "dest": "/api/generate-token.js"
    },
    {
      "src": "/channel-info",
      "dest": "/api/channel-info.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "env": {
    "AGORA_APP_ID": "",
    "AGORA_APP_CERTIFICATE": ""
  }
}
